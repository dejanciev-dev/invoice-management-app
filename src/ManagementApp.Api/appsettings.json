{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ManagementApp;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "SeedDemoData": false
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Demo": {
    "Enabled": false,
    "AllowInProduction": false
  },
  "Platform": {
    "AdminEmails": []
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/files"
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@localhost",
    "SystemFromName": "Invoice Manager",
    "PollSeconds": 10,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "Auto"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "SignIn": { "PermitLimit": 10, "WindowSeconds": 60 },
    "AccountCreation": { "PermitLimit": 5, "WindowSeconds": 3600 },
    "Invitations": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "IntervalMinutes": 360
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
